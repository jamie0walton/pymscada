[Unit]
    Description=MobileSCADA Openweather Client__SITE__
    BindsTo=__PREFIX__-bus.service
    After=__PREFIX__-bus.service
    After=__PREFIX__-initvalues.service

[Service]
    WorkingDirectory=__DIR__
    ExecStart=__PYMSCADA__ openweatherclient --config __DIR__/yaml/openweather.yaml
    Restart=always
    RestartSec=5
    User=__USER__
    Group=__USER__

[Install]
    WantedBy=multi-user.target
