[Unit]
    Description=pymscada - wwwserver
    BindsTo=pymscada-bus.service
    After=pymscada-bus.service

[Service]
    WorkingDirectory=__DIR__
    ExecStart=__PYMSCADA__ wwwserver --config __DIR__/yaml/wwwserver.yaml --tags __DIR__/yaml/tags.yaml
    Restart=always
    RestartSec=5
    User=__USER__
    Group=__USER__

[Install]
    WantedBy=multi-user.target